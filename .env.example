# Copy to .env for local development. Never commit .env.
# `netlify dev` also injects these from your linked Netlify site.

# SnapTrade Personal OAuth client (docs/architecture.md "SnapTrade"). Created
# once in the SnapTrade dashboard under Settings > OAuth App. Register
# http://localhost:5173/auth/snaptrade/callback as a redirect URI for local
# dev. Server-only; never shipped to a client. The app must also have the
# partner-only `trade` scope enabled by SnapTrade for orders to work.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=

# Signs the session and OAuth-state cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# 32-byte AES-256-GCM key for SnapTrade tokens at rest, base64. Generate with:
#   openssl rand -base64 32
# Rotating it invalidates stored tokens; users sign in again.
TOKEN_ENCRYPTION_KEY=

# Optional. Public origin for the OAuth redirect URI when it differs from the
# request origin (for example a branch deploy registered with SnapTrade).
# APP_ORIGIN=https://noadviceneeded.ca

# Database: nothing to set. `pnpm dev` starts a local Postgres through the
# Netlify Vite plugin and injects NETLIFY_DB_URL; Netlify provisions the real
# one on deploy. Apply migrations locally with `netlify database migrations apply`.
